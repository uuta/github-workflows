#!/usr/bin/env bash
set -euo pipefail

if [ "$1 $2" = "pr diff" ]; then
  if [ "${MOCK_DIFF_FAILURE:-false}" = true ]; then
    echo 'could not find pull request diff: HTTP 406: diff exceeded maximum lines' >&2
    echo 'PullRequest.diff too_large' >&2
    exit 1
  fi
  printf '%s\n' "$MOCK_CHANGED_FILES"
  exit 0
fi

if [ "$1" = "api" ] && [[ "$*" == *"/pulls/"*"/files?"* ]]; then
  cat "$MOCK_PULL_FILES"
  exit 0
fi

if [ "$1" = "api" ] && [[ "$*" == *"--method POST"* ]]; then
  printf '%s\n' "$*" >> "$MOCK_POST_LOG"
  exit 0
fi

if [ "$1" = "api" ] && [[ "$*" == *"/issues/"*"/comments?"* ]]; then
  cat "$MOCK_COMMENTS"
  exit 0
fi

printf 'Unexpected gh invocation: %s\n' "$*" >&2
exit 2
